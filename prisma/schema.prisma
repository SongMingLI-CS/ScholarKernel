generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- NextAuth.js standard models ---

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  accounts       Account[]
  sessions       Session[]
  conversations  Conversation[]
  documents      Document[]
  settings       UserSetting?
  agentJobs      AgentJob[]
  billing        UserBilling?
  tokenAuditLogs TokenAuditLog[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

// --- Application models ---

model Conversation {
  id              String           @id @default(cuid())
  userId          String?
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String           @default("新对话")
  isPinned        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        Message[]
  canvasDocuments CanvasDocument[]

  @@index([userId, isPinned, updatedAt])
}

/// Scholar Canvas 会话内可编辑文档（与全局文献库解耦）
model CanvasDocument {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title          String       @default("未命名文档")
  content        String       @default("")
  version        Int          @default(1)
  isShared       Boolean      @default(false)
  shareToken     String?      @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, updatedAt])
}

/// 用户全局文献资产库（跨会话持久化）
model Document {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  fileSize    Int
  fileType    String
  tags        String[]        @default([])
  folders     String[]        @default([])
  indexStatus String          @default("pending")
  indexError  String?         @db.Text
  indexedAt   DateTime?
  createdAt   DateTime        @default(now())
  chunks      DocumentChunk[]

  @@index([userId])
}

/// Parsed, bounded evidence units for query-time Library retrieval.
model DocumentChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  section    String
  page       Int?
  content    String   @db.Text
  charCount  Int
  createdAt  DateTime @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model UserSetting {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme       String   @default("dark")
  runtimeKeys String?
  updatedAt   DateTime @updatedAt
}

enum AgentJobStatus {
  pending
  running
  done
  error
}

model AgentJob {
  id           String         @id @default(cuid())
  userId       String?
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       AgentJobStatus @default(pending)
  input        String
  provider     Json?
  checkpoint   Json?
  result       Json?
  /// @deprecated 与 errorMessage 同步；新写入请用 errorMessage
  error        String?
  errorMessage String?        @db.Text
  errorStack   String?        @db.Text
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  nodes        AgentNode[]

  @@index([userId, status, updatedAt])
}

/// 智能体工作流单节点快照：支持断点续跑与就地重试。
model AgentNode {
  id           String         @id @default(cuid())
  jobId        String
  job          AgentJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  nodeId       String
  status       AgentJobStatus @default(pending)
  outputs      Json?
  nodeSnapshot Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([jobId, nodeId])
  @@index([jobId, status])
}

// --- Billing models ---

model UserBilling {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalSpent Float    @default(0)
  tokenQuota Int      @default(500000)
  tokenUsed  Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model TokenAuditLog {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String?
  modelUsed      String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  calculatedCost Float    @default(0)
  ttftMs         Int?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, jobId])
}
