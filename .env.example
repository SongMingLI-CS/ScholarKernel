# SQLite database (required)
DATABASE_URL="file:./prisma/dev.db"

# Server-side encryption for persisted runtime API keys (required in production)
# Generate: openssl rand -base64 32
ENCRYPTION_SECRET=

# Alias accepted by crypto-server (optional; ENCRYPTION_SECRET takes precedence when both set)
# DATABASE_ENCRYPTION_KEY=

# Proxy route auth token — required when exposing /api/proxy publicly (see README)
# PROXY_ACCESS_TOKEN=

# Auth session secret — required when AUTH is enabled (Issue #3+)
# AUTH_SESSION_SECRET=
