# PostgreSQL Connection (e.g., Neon or Supabase)
# Neon: DATABASE_URL 使用带 -pooler 的连接串；DIRECT_URL 使用直连（迁移 / CLI）
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Server-only encryption/signing secret. Use a high-entropy value in production.
ENCRYPTION_SECRET="replace-with-output-from-openssl-rand-base64-32"

# Auth.js / optional credentials login
AUTH_SECRET="replace-with-an-independent-high-entropy-secret"
# AUTH_PASSWORD="replace-with-a-strong-login-password"
# AUTH_USER_ID="primary_user"
# AUTH_USER_EMAIL="admin@example.com"
# GITHUB_ID="github-oauth-client-id"
# GITHUB_SECRET="github-oauth-client-secret"

# Private Library object storage (required for uploads in production)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token"
# Vercel OIDC alternative: set both values in the deployment environment
# VERCEL_OIDC_TOKEN="vercel-oidc-token"
# BLOB_STORE_ID="store-id"

# Server-only model/search credentials. Users may alternatively save provider
# keys through Settings; they are encrypted at rest and never returned to the browser.
# OPENAI_API_KEY="sk-..."
# ANTHROPIC_API_KEY="sk-ant-..."
# GOOGLE_API_KEY="..."
# GEMINI_API_KEY="..."
# DEEPSEEK_API_KEY="..."
# TAVILY_API_KEY="tvly-..."
# SERPER_API_KEY="..."

# Optional semantic reranking; lexical reranking is the fallback
# COHERE_API_KEY="..."
# RERANK_API_URL="https://reranker.example.com/rerank"
# RERANK_API_KEY="..."
# RERANK_MODEL="BAAI/bge-reranker-large"

# Optional distributed API rate limiting (without both values, requests fail open)
# UPSTASH_REDIS_REST_URL="https://...upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."

# Optional external PDF/DOCX layout parser; local parsing is the fallback
# LAYOUT_PARSER_URL="https://parser.example.com/parse"
# LAYOUT_PARSER_API_KEY="..."

# Optional: Proxy gateway (required for public deployments)
# PROXY_ACCESS_TOKEN="your-proxy-token"
# PROXY_RATE_LIMIT_PER_MIN=60

# Legacy aliases accepted by the current runtime (prefer AUTH_SECRET and ENCRYPTION_SECRET)
# AUTH_SESSION_SECRET="legacy-session-signing-secret"
# NEXTAUTH_SECRET="legacy-nextauth-secret"
# DATABASE_ENCRYPTION_KEY="legacy-encryption-secret"

# Local acceptance tooling only (never configure these as production runtime values)
# STAGING_DATABASE_URL="postgresql://user:password@staging-host/dbname?sslmode=require"
# STAGING_EXPECTED_DB_HOST="staging-host"
# STAGING_BASE_URL="https://staging.example.com"
# STAGING_EXPECTED_HOST="staging.example.com"
# STAGING_CONFIRMATION="scholarkernel-staging"
# STAGING_AUTH_COOKIE="authjs.session-token=..."
# PLAYWRIGHT_BASE_URL="http://127.0.0.1:3000"
