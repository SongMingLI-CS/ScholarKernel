# SQLite database (required)
DATABASE_URL="file:./prisma/dev.db"

# Server-side encryption for persisted runtime API keys (required in production)
# Generate: openssl rand -base64 32
ENCRYPTION_SECRET=

# Alias accepted by crypto-server (optional; ENCRYPTION_SECRET takes precedence when both set)
# DATABASE_ENCRYPTION_KEY=

# Proxy route auth token — required in production (see README)
PROXY_ACCESS_TOKEN=

# Optional: per-IP proxy requests per minute (default 60)
# PROXY_RATE_LIMIT_PER_MIN=60

# Auth session secret — required when AUTH_PASSWORD is set (defaults to ENCRYPTION_SECRET)
# AUTH_SESSION_SECRET=

# Single-user access password — when set, login is required for API routes
# AUTH_PASSWORD=

# User id stored in DB for authenticated sessions (default: primary_user)
# AUTH_USER_ID=primary_user
