# PostgreSQL Connection (e.g., Neon or Supabase)
# Neon: DATABASE_URL 使用带 -pooler 的连接串；DIRECT_URL 使用直连（迁移 / CLI）
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Optional server-side model keys. They can also be configured in the app's
# runtime key panel. Leave unset when running tests that use local mocks.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=                 # GEMINI_API_KEY is also accepted
# DEEPSEEK_API_KEY=

# Optional academic search providers
# TAVILY_API_KEY=
# SERPER_API_KEY=

# Optional server-side reranker; without one, retrieval uses local lexical ranking.
# COHERE_API_KEY=
# RERANK_API_URL=
# RERANK_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-large

# Optional local dense embedding endpoint implementing POST /v1/embeddings.
# Pin the exact model revision; unset the URL or revision to use BM25-only retrieval.
# LOCAL_EMBEDDING_API_URL=http://127.0.0.1:8999/v1/embeddings
# LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
# LOCAL_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
# LOCAL_EMBEDDING_DIMENSIONS=1024

# Optional local cross-encoder endpoint implementing POST /v1/rerank.
# Local document snippets are sent only to this explicitly configured local endpoint.
# LOCAL_RERANKER_API_URL=http://127.0.0.1:8999/v1/rerank
# LOCAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# LOCAL_RERANKER_REVISION=c5ee24cb16019beea0893ab7796b1df96625c6b8
# The separate SciFact fine-tuned checkpoint uses its model ID and SHA-256
# revision from docs/upgrade/phase4-reranker.md.

# BM25 lexical retrieval parameters (bounded k1 0..3, b 0..1).
# RAG_BM25_K1=1.2
# RAG_BM25_B=0.75

# Server-side AES Encryption Secret (Must be exactly 32 bytes for production)
ENCRYPTION_SECRET="your_32_character_super_secret_key"

# Optional: Proxy gateway (required for public deployments)
# PROXY_ACCESS_TOKEN="your-proxy-token"
# PROXY_RATE_LIMIT_PER_MIN=60

# Optional: App login gate
# AUTH_PASSWORD="your-app-password"
# AUTH_SESSION_SECRET="your-session-signing-secret"
# AUTH_USER_ID="primary_user"

# Durable server Agent jobs (opt-in). Start `npm run worker` separately.
# Set NEXT_PUBLIC_AGENT_EXECUTION at build time; unset it to use legacy browser execution.
# AGENT_DURABLE_JOBS=1
# NEXT_PUBLIC_AGENT_EXECUTION=server
